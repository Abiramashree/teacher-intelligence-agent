# Copy to .env and adjust. All values have sensible defaults for a local,
# open-source (Ollama) demo, so you can also just leave .env empty.

# --- LLM backend ---
# "ollama" (default, local open-source models) or "openai" (any OpenAI-compatible server)
LLM_PROVIDER=ollama

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
SUMMARY_MODEL=llama3.1:8b
AGENT_MODEL=llama3.1:8b

# OpenAI-compatible endpoint (used when LLM_PROVIDER=openai) — e.g. a LiteLLM gateway or vLLM
# OPENAI_BASE_URL=http://localhost:4000/v1
# OPENAI_API_KEY=not-needed

# --- Retrieval ---
EMBED_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# --- Data / index locations ---
DATA_DIR=data
PERSIST_DIR=faiss_store
