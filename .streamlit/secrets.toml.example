# Streamlit Community Cloud configuration.
# In the app dashboard: Settings -> Secrets -> paste the block below (without this
# comment), using your own key. Locally you can instead copy this to
# .streamlit/secrets.toml (git-ignored) to test the hosted config.
#
# The model runs on Groq's free API (open-source Llama models) via its OpenAI-compatible
# endpoint. Embeddings still run locally in the app. Get a free key at
# https://console.groq.com/keys

LLM_PROVIDER = "openai"
OPENAI_BASE_URL = "https://api.groq.com/openai/v1"
OPENAI_API_KEY = "gsk_your_groq_key_here"
SUMMARY_MODEL = "llama-3.1-8b-instant"       # fast + cheap for quick summaries
AGENT_MODEL = "llama-3.3-70b-versatile"      # supports tool calling for the full agent
