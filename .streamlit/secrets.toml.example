# Streamlit Community Cloud configuration.
# In the app dashboard: Settings -> Secrets -> paste the block below (without this
# comment), using your own key. Locally you can instead copy this to
# .streamlit/secrets.toml (git-ignored) to test the hosted config.
#
# The model runs on OpenRouter's free tier (open-weight models) via its OpenAI-compatible
# endpoint. Embeddings still run locally in the app. Get a free key at
# https://openrouter.ai/keys  (and enable free models at https://openrouter.ai/settings/privacy)

LLM_PROVIDER = "openai"
OPENAI_BASE_URL = "https://openrouter.ai/api/v1"
OPENAI_API_KEY = "sk-or-your_key_here"
SUMMARY_MODEL = "google/gemma-4-26b-a4b-it:free"
AGENT_MODEL = "google/gemma-4-26b-a4b-it:free"

# --- Alternative: native Google Gemini (proprietary, not open-source) ---
# Free tier, and the agent/PDF (tool-calling) path works reliably because the native
# client replays Gemini 3.x thought signatures through the tool loop (the OpenAI-compat
# endpoint does not, which 400s on the PDF step). Get a key at
# https://aistudio.google.com/apikey  Use INSTEAD of the block above:
#
# LLM_PROVIDER = "gemini"
# GOOGLE_API_KEY = "AIza_your_key"
# SUMMARY_MODEL = "gemini-2.5-flash"
# AGENT_MODEL = "gemini-2.5-flash"
