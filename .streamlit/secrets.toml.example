# Streamlit Community Cloud configuration.
# In the app dashboard: Settings -> Secrets -> paste the block below (without this
# comment), using your own Hugging Face token. Locally you can instead copy this to
# .streamlit/secrets.toml (git-ignored) to test the hosted config.
#
# The model runs on Hugging Face's serverless Inference Providers (open-source models),
# called through their OpenAI-compatible router. Embeddings still run locally in the app.

LLM_PROVIDER = "openai"
OPENAI_BASE_URL = "https://router.huggingface.co/v1"
OPENAI_API_KEY = "hf_your_token_here"          # a token from https://huggingface.co/settings/tokens
SUMMARY_MODEL = "Qwen/Qwen2.5-7B-Instruct"
AGENT_MODEL = "Qwen/Qwen2.5-7B-Instruct"
